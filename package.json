{
  "name": "auctus-academy-mcp",
  "version": "0.0.1",
  "private": true,
  "description": "Auctus MCP Server (Phase 0 read-only beta foundation)",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "wrangler dev",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:secrets": "bash scripts/check-no-service-role.sh",
    "typecheck": "tsc --noEmit",
    "smoke": "node pentest/smoke.mjs",
    "load:rate-limit": "node pentest/load-rate-limit.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/auctusstore-arch/auctus-academy-mcp.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^10.15.0",
    "jose": "^6.2.17",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5",
    "wrangler": "^4.162.0"
  }
}
